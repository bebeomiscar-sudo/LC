local function createLinearTracer(fromPos, toPos, color, fadeTime)
    local line = Drawing.new("Line")
    line.From      = fromPos
    line.To        = toPos
    line.Color     = color
    line.Thickness = 1.5
    line.Visible   = true
    task.delay(fadeTime, function()
        for i = 1, 10 do
            line.Transparency = i / 10
            task.wait(fadeTime / 10)
        end
        line:Remove()
    end)
end

local function createLightningTracer(fromPos, toPos, color, fadeTime)
    -- Segmented jagged line to simulate lightning
    local segments = 8
    local prev = fromPos
    local lines = {}
    for i = 1, segments do
        local t = i / segments
        local basePos = fromPos:Lerp(toPos, t)
        local jitter = Vector2.new(math.random(-15,15), math.random(-15,15))
        local seg = Drawing.new("Line")
        seg.From      = prev
        seg.To        = basePos + jitter
        seg.Color     = color
        seg.Thickness = 1
        seg.Visible   = true
        table.insert(lines, seg)
        prev = seg.To
    end
    task.delay(fadeTime, function()
        for _, l in pairs(lines) do
            pcall(function() l:Remove() end)
        end
    end)
end

local function createDragonTracer(fromPos, toPos, color, fadeTime)
    -- Wavy sinusoidal tracer styled like a dragon
    local segments = 12
    local prev = fromPos
    local lines = {}
    for i = 1, segments do
        local t = i / segments
        local basePos = fromPos:Lerp(toPos, t)
        local wave = math.sin(t * math.pi * 4) * 20
        local seg = Drawing.new("Line")
        seg.From      = prev
        seg.To        = basePos + Vector2.new(wave, wave * 0.5)
        seg.Color     = Color3.fromRGB(255, math.floor(50 + t*150), 0)
        seg.Thickness = 2
        seg.Visible   = true
        table.insert(lines, seg)
        prev = seg.To
    end
    task.delay(fadeTime, function()
        for _, l in pairs(lines) do
            pcall(function() l:Remove() end)
        end
    end)
end

local function createSonicTracer(fromPos, toPos, color, fadeTime)
    -- Fast straight with a cyan glow ring
    local line = Drawing.new("Line")
    line.From      = fromPos
    line.To        = toPos
    line.Color     = Color3.fromRGB(30, 200, 255)
    line.Thickness = 2.5
    line.Visible   = true
    local ring = Drawing.new("Circle")
    ring.Position  = fromPos
    ring.Radius    = 8
    ring.Filled    = false
    ring.Color     = Color3.fromRGB(30, 200, 255)
    ring.Thickness = 1.5
    ring.Visible   = true
    task.delay(fadeTime, function()
        pcall(function() line:Remove() end)
        pcall(function() ring:Remove() end)
    end)
end

local function createMinecraftTracer(fromPos, toPos, color, fadeTime)
    -- Blocky squared segments
    local segments = 6
    local prev = fromPos
    local lines = {}
    for i = 1, segments do
        local t = i / segments
        local basePos = fromPos:Lerp(toPos, t)
        local snap = Vector2.new(math.floor(basePos.X/8)*8, math.floor(basePos.Y/8)*8)
        local seg = Drawing.new("Line")
        seg.From      = prev
        seg.To        = snap
        seg.Color     = Color3.fromRGB(100, 255, 100)
        seg.Thickness = 3
        seg.Visible   = true
        table.insert(lines, seg)
        prev = seg.To
    end
    task.delay(fadeTime, function()
        for _, l in pairs(lines) do
            pcall(function() l:Remove() end)
        end
    end)
end

local function spawnTracer(fromWorldPos, toWorldPos)
    if not State.TracerEnabled then return end
    local fromScreen, fs = Camera:WorldToViewportPoint(fromWorldPos)
    local toScreen, ts   = Camera:WorldToViewportPoint(toWorldPos)
    if not fs or not ts then return end
    local f2 = Vector2.new(fromScreen.X, fromScreen.Y)
    local t2 = Vector2.new(toScreen.X, toScreen.Y)
    local style = State.TracerStyle
    local color = State.TracerColor
    local fade  = State.TracerFadeTime
    if style == "Line"       then createLinearTracer(f2, t2, color, fade)
    elseif style == "Lightning" then createLightningTracer(f2, t2, color, fade)
    elseif style == "Dragon"    then createDragonTracer(f2, t2, color, fade)
    elseif style == "Sonic"     then createSonicTracer(f2, t2, color, fade)
    elseif style == "Minecraft" then createMinecraftTracer(f2, t2, color, fade)
    end
end

