--               WATERMARK
-- ══════════════════════════════════════════════
Library:SetWatermarkVisibility(true)

local _wFrameTimer   = tick()
local _wFrameCounter = 0
local _wFPS          = 60

local _wmConn = RunService.RenderStepped:Connect(function()
    _wFrameCounter += 1
    if (tick() - _wFrameTimer) >= 1 then
        _wFPS          = _wFrameCounter
        _wFrameTimer   = tick()
        _wFrameCounter = 0
    end
    local pingOk, ping = pcall(function()
        return math.floor(
            game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        )
    end)
    if pingOk then
        Library:SetWatermark(
            ("sexhook | %d fps | %d ms"):format(math.floor(_wFPS), ping)
        )
    else
        Library:SetWatermark(
            ("sexhook | %d fps"):format(math.floor(_wFPS))
        )
    end
end)

-- ══════════════════════════════════════════════
--              UNLOAD HANDLER
-- ══════════════════════════════════════════════
Library:OnUnload(function()
    _wmConn:Disconnect()
    VoidSpam.stop()
    Desync.disable()
    StandoffDesync.disable()
    UndergroundAA.disable()
    getgenv().BaitSystem.disable()
    getgenv().ShieldGM.disable()
    Dodge.active = false
    print("[sexhook] unloaded cleanly")
    Library.Unloaded = true
end)

