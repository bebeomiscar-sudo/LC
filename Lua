local function applySmartLock(tRot, cur, dt, screenDist, fovRadius)
    local distFactor = AB.speed
    if fovRadius > 0 then
        local normalized = math.clamp(screenDist / fovRadius, 0, 1)
        distFactor = AB.speed + (AB.speedScaleFov/100) * (1-normalized) * math.max(AB.speedAttack-AB.speed, 0)
    end
    local eff = math.clamp(distFactor, 0.01, 5)
    local factor = math.clamp(eff * dt * 6, 0, 1)
    if AB.lockMode == "Soft" or AB.lockMode == "Magnet" then
        return Vector2.new(cur.X+(tRot.X-cur.X)*factor, cur.Y+angDiff(cur.Y,tRot.Y)*factor)
    else
        local distP=math.abs(tRot.X-cur.X); local distY=math.abs(angDiff(cur.Y,tRot.Y))
        local dist=math.sqrt(distP^2+distY^2)
        if abCurveStart==nil or dist>0.5 then abCurveStart=cur; abCurveProgress=0 end
        abCurveEnd=tRot
        local speed2=(AB.curvePct/100)*3*eff
        abCurveProgress=math.clamp(abCurveProgress+speed2*dt,0,1)
        local t=abCurveProgress; local curved=t*t*(3-2*t)
        local nP=abCurveStart.X+(abCurveEnd.X-abCurveStart.X)*curved
        local nY=abCurveStart.Y+angDiff(abCurveStart.Y,abCurveEnd.Y)*curved
        if abCurveProgress>=1 then abCurveStart=nil; abCurveProgress=0 end
        return Vector2.new(nP, nY)
    end
end

-- AI LEGIT LAYER
local AI = {on=false, jitter=0.002, overshoot=0.12, breakChance=0.008, breakDur=0.25, varySmooth=true}
local aiBreakTimer=0; local aiInBreak=false; local aiJitterX=0; local aiJitterY=0

local function aiLegitProcess(newRot, cur, dt)
    if not AI.on then return newRot end
    if aiInBreak then
        aiBreakTimer=aiBreakTimer-dt; if aiBreakTimer<=0 then aiInBreak=false end; return cur
    end
    if math.random() < AI.breakChance*dt*60 then
        aiInBreak=true; aiBreakTimer=AI.breakDur+(math.random()-0.5)*0.1; return cur
    end
    aiJitterX=aiJitterX+(math.random()-0.5)*AI.jitter; aiJitterY=aiJitterY+(math.random()-0.5)*AI.jitter
    aiJitterX=aiJitterX*0.85; aiJitterY=aiJitterY*0.85
    local over=AI.overshoot; if AI.varySmooth then over=over*(0.7+math.random()*0.6) end
    local nX=newRot.X+aiJitterX; local nY=newRot.Y+aiJitterY
    if math.random()<0.1 then nX=nX+(math.random()-0.5)*over; nY=nY+(math.random()-0.5)*over end
    return Vector2.new(nX, nY)
end

