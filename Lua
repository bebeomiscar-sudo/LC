-- ============================================================
-- RENDERSTEP LOOP
-- ============================================================
RunService.RenderStepped:Connect(function(dt)
    local aimOrigin = getAimOrigin()
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")

    -- // FOV CIRCLE
    if State.AimbotVisFOVCirc then
        FOVCircle.Visible   = true
        FOVCircle.Position  = aimOrigin
        FOVCircle.Radius    = State.AimbotFOV
    else
        FOVCircle.Visible   = false
    end

    -- // CENTER DOT (only show when center mode is ON)
    if State.MobileCenterMode then
        local vp           = Camera.ViewportSize
        CenterDot.Visible  = true
        CenterDot.Position = Vector2.new(vp.X / 2, vp.Y / 2)
    else
        CenterDot.Visible  = false
    end

    -- // AIMBOT
    if State.AimbotEnabled then
        local target = getClosestPlayerToMouse(State.AimbotFOV)
        if target then
            local bone = getBodyPart(target, State.AimbotBone)
            if bone then
                local targetPos = State.AimbotPrediction
                    and predictPosition(
                        bone.Parent:FindFirstChild("HumanoidRootPart")
                    )
                    or bone.Position
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
                if onScreen then
                    local camCF   = Camera.CFrame
                    local targetCF = CFrame.new(camCF.Position, targetPos)
                    local newCF   = camCF:Lerp(
                        targetCF,
                        math.clamp(State.AimbotSmooth, 0.01, 1)
                    )
                    Camera.CFrame = newCF
                end
            end
        end
    end

    -- // ANTI-AIM
    if State.AntiAimEnabled and R_UpdateCameraRotations and localRoot then
        State.AntiAimTick = State.AntiAimTick + dt
        local yaw  = 0
        local mode = State.AntiAimMode
        if mode == "Spin" then
            yaw = (State.AntiAimTick * 720) % 360
        elseif mode == "Jitter" then
            yaw = (math.random() > 0.5 and 1 or -1) * 90
        elseif mode == "Static180" then
            yaw = 180
        elseif mode == "Backward" then
            yaw = 180
        end
        local spoofedCF = CFrame.new(localRoot.Position)
            * CFrame.Angles(0, math.rad(yaw + localRoot.Orientation.Y), 0)
        pcall(function()
            R_UpdateCameraRotations:FireServer(spoofedCF)
        end)
    end

    -- // TRIGGERBOT
    if State.TriggerbotEnabled then
        local now = tick()
        if now - lastTriggerFire >= State.TriggerbotDelay then
            local vp       = Camera.ViewportSize
            local rayOrigin

            -- Mobile: cast from center | PC: cast from mouse
            if State.MobileCenterMode then
                rayOrigin = Vector2.new(vp.X / 2, vp.Y / 2)
            else
                rayOrigin = UserInputService:GetMouseLocation()
            end

            local unitRay  = Camera:ScreenPointToRay(rayOrigin.X, rayOrigin.Y)
            local rayParams = RaycastParams.new()
            rayParams.FilterDescendantsInstances = {
                LocalPlayer.Character or workspace
            }
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            local result = workspace:Raycast(
                unitRay.Origin,
                unitRay.Direction * 1000,
                rayParams
            )
            if result and result.Instance then
                local hitModel  = result.Instance:FindFirstAncestorOfClass("Model")
                local hitPlayer = hitModel and Players:GetPlayerFromCharacter(hitModel)
                if hitPlayer and hitPlayer ~= LocalPlayer then
                    if R_UseItem then
                        pcall(function()
                            R_UseItem:InvokeServer()
                        end)
                    end
                    lastTriggerFire = now
                end
            end
        end
    end

    -- // UTILITY ESP
    if State.UtilityESPEnabled then
        -- Clean dead labels
        for i = #State.UtilityESPObjects, 1, -1 do
            local obj = State.UtilityESPObjects[i]
            if not obj.part or not obj.part.Parent then
                pcall(function() obj.label:Remove() end)
                pcall(function() obj.dist:Remove()  end)
                table.remove(State.UtilityESPObjects, i)
            end
        end
        -- Scan workspace
        local utilityKeywords = {
            "grenade","flashbang","smoke","molotov",
            "throwable","utility","mine","satchel","snowball"
        }
        for _, part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Model") then
                local nm     = part.Name:lower()
                local isUtil = false
                for _, kw in ipairs(utilityKeywords) do
                    if nm:find(kw) then isUtil = true break end
                end
                if isUtil then
                    local alreadyTracked = false
                    for _, existing in pairs(State.UtilityESPObjects) do
                        if existing.part == part then
                            alreadyTracked = true break
                        end
                    end
                    if not alreadyTracked then
                        local labelDraw     = Drawing.new("Text")
                        labelDraw.Size      = 14
                        labelDraw.Color     = Color3.fromRGB(255, 200, 0)
                        labelDraw.Outline   = true
                        labelDraw.Text      = "[" .. part.Name .. "]"
                        local distDraw      = Drawing.new("Text")
                        distDraw.Size       = 12
                        distDraw.Color      = Color3.fromRGB(200, 200, 200)
                        distDraw.Outline    = true
                        table.insert(State.UtilityESPObjects, {
                            part  = part,
                            label = labelDraw,
                            dist  = distDraw,
                        })
                    end
                end
            end
        end
        -- Update positions
        if localRoot then
            for _, obj in pairs(State.UtilityESPObjects) do
                local pos3d
                if obj.part:IsA("BasePart") then
                    pos3d = obj.part.Position
                elseif obj.part:IsA("Model") and obj.part.PrimaryPart then
                    pos3d = obj.part.PrimaryPart.Position
                end
                if pos3d then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(pos3d)
                    obj.label.Visible = onScreen
                    obj.dist.Visible  = onScreen
                    if onScreen then
                        obj.label.Position = Vector2.new(screenPos.X, screenPos.Y - 20)
                        local d = math.floor(
                            (pos3d - localRoot.Position).Magnitude
                        )
                        obj.dist.Text     = d .. "m"
                        obj.dist.Position = Vector2.new(screenPos.X, screenPos.Y - 6)
                    end
                end
            end
        end
    end
end)

-- ============================================================
-- SILENT AIM HOOK
-- ============================================================
local function setupSilentAim()
    local mt = getrawmetatable(game)
    local oldNamecall
    local wasReadonly = isreadonly(mt)
    if wasReadonly then setreadonly(mt, false) end
    oldNamecall = mt.__namecall
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" or method == "InvokeServer" then
            local args = {...}
            if self == R_UseItem and State.SilentAimEnabled then
                local target = getClosestPlayerToMouse(State.AimbotFOV)
                if target then
                    local bone = getBodyPart(target, State.SilentBone)
                    if bone then
                        local targetPos = State.AimbotPrediction
                            and predictPosition(
                                bone.Parent:FindFirstChild("HumanoidRootPart")
                            )
                            or bone.Position
                        if type(args[1]) == "table" then
                            args[1].Position = targetPos
                        elseif type(args[1]) == "userdata" then
                            for i, v in pairs(args) do
                                if type(v) == "vector"
                                or (type(v) == "userdata"
                                    and tostring(v):find("Vector3")) then
                                    args[i] = targetPos
                                end
                            end
                        end
                    end
                end
            end
            return oldNamecall(self, table.unpack(args))
        end
        return oldNamecall(self, ...)
    end)
    if wasReadonly then setreadonly(mt, true) end
end

pcall(setupSilentAim)

