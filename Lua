-- SILENT AIM â€” hook via RemoteEvent
-- ============================================================
local originalFireServer
local function setupSilentAim()
    -- We hook Replicate (position+aim replication) to redirect aim
    -- This intercepts the fire position so server thinks you hit an enemy
    local mt = getrawmetatable(game)
    local oldNamecall
    local wasReadonly = isreadonly(mt)
    if wasReadonly then setreadonly(mt, false) end
    oldNamecall = mt.__namecall
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" or method == "InvokeServer" then
            local args = {...}
            -- Check if this is UseItem remote
            if self == R_UseItem and State.SilentAimEnabled then
                local target = getClosestPlayerToMouse(State.AimbotFOV)
                if target then
                    local bone = getBodyPart(target, State.SilentBone)
                    if bone then
                        local targetPos = State.AimbotPrediction
                            and predictPosition(bone.Parent:FindFirstChild("HumanoidRootPart")) or bone.Position
                        -- inject target position into args if table
                        if type(args[1]) == "table" then
                            args[1].Position = targetPos
                        elseif type(args[1]) == "userdata" then
                            -- replace CFrame arg
                            for i, v in pairs(args) do
                                if type(v) == "vector" or (type(v) == "userdata" and tostring(v):find("Vector3")) then
                                    args[i] = targetPos
                                end
                            end
                        end
                    end
                end
            end
            return oldNamecall(self, table.unpack(args))
        end
        return oldNamecall(self, ...)
    end)
    if wasReadonly then setreadonly(mt, true) end
end

pcall(setupSilentAim)

