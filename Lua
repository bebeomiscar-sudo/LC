-- ============================================================
local RIOT={enabled=false, blockBullets=true, blockProjectiles=true, autoFace=true}
local PROJECTILE_NAMES={"Bow","Daggers","Slingshot","Paintball Gun"}
local riotConn=nil

local function isProjectileWeapon(name)
    if not name then return false end
    for _,wn in ipairs(PROJECTILE_NAMES) do
        if name:lower():find(wn:lower()) then return true end
    end
    return false
end

local function setupRiotShield()
    if riotConn then riotConn:Disconnect() end
    riotConn=rs.Heartbeat:Connect(function()
        if not RIOT.enabled then return end
        -- Force shield to stay unbroken via FighterController item list
        pcall(function()
            if not mFig then return end
            local fc=mFig
            -- Patch LocalFighter items
            if fc.LocalFighter and fc.LocalFighter.Items then
                for _,it in pairs(fc.LocalFighter.Items) do
                    if it and rawget(it,"_is_broken")~=nil then
                        rawset(it,"_is_broken",false)
                        -- keep idle anim normal
                        if it.ViewModel then
                            pcall(function() it.ViewModel:OverrideRootPartOffset(nil) end)
                            pcall(function() it.ViewModel:ChangeIdleAnimation("Idle") end)
                        end
                    end
                end
            end
        end)
        -- Auto-face nearest enemy (priority: projectile users)
        if RIOT.autoFace and ch and hrp then
            local nearest, nearDist=nil, math.huge
            for _,p in ipairs(plr:GetPlayers()) do
                if p==lp then continue end
                local pc=p.Character; if not pc then continue end
                local pr=pc:FindFirstChild("HumanoidRootPart"); if not pr then continue end
                local d=(hrp.Position-pr.Position).Magnitude
                -- Prioritise projectile weapons
                local enemyLf=nil
                pcall(function() if mFig then enemyLf=mFig:GetFighter(p) end end)
                local isProj=false
                if enemyLf and enemyLf.EquippedItem then
                    local eName=""
                    pcall(function() eName=tostring(enemyLf.EquippedItem:Get("ObjectID") or "") end)
                    isProj=isProjectileWeapon(eName)
                end
                if isProj and RIOT.blockProjectiles then
                    if d<nearDist then nearDist=d; nearest=pr end
                elseif RIOT.blockBullets and d<nearDist then
                    nearDist=d; nearest=pr
                end
            end
            if nearest then
                local dir=(nearest.Position-hrp.Position)*Vector3.new(1,0,1)
                if dir.Magnitude>0.1 then
                    pcall(function() hrp.CFrame=CFrame.new(hrp.Position, hrp.Position+dir.Unit) end)
                end
            end
        end
    end)
end

local function teardownRiotShield()
    RIOT.enabled=false
    if riotConn then riotConn:Disconnect(); riotConn=nil end
end

