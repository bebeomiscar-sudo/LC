local VIS = { esp=false, tracers=false, tracerThick=1.5, tracerDur=0.4, tracerColor=Color3.fromRGB(255,50,50) }

-- ============================================================
-- TRACERS (fixed: only spawns from fireShot/rgFire calls)
-- ============================================================
local tracers = {}

local function spawnTracer(o3, t3)
    if not VIS.tracers then return end
    local l = Drawing.new("Line")
    l.Thickness = VIS.tracerThick; l.Color = VIS.tracerColor
    l.Transparency = 0; l.Visible = false
    table.insert(tracers, {line=l, born=tick(), o=o3, t=t3})
end

local function updateTracers()
    local now = tick(); local alive = {}
    for _, t in ipairs(tracers) do
        local age = now - t.born; local life = math.max(VIS.tracerDur, 0.05)
        if age >= life then pcall(function() t.line:Remove() end)
        else
            local a = 1-(age/life)
            local fromS = w2s(t.o); local toS = w2s(t.t)
            if fromS and toS then
                t.line.From=fromS; t.line.To=toS
                t.line.Transparency=1-a; t.line.Visible=true
            else t.line.Visible=false end
            table.insert(alive, t)
        end
    end
    tracers = alive
end

