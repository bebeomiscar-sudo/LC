-- ============================================================
local function getEnemies()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            table.insert(list, p)
        end
    end
    return list
end

-- Returns screen position to use for FOV check
-- PC = mouse position | Mobile = screen center
local function getAimOrigin()
    if IsMobile or State and State.MobileCenterMode then
        local vp = Camera.ViewportSize
        return Vector2.new(vp.X / 2, vp.Y / 2)
    end
    return UserInputService:GetMouseLocation()
end

local function getClosestPlayerToMouse(maxDist)
    maxDist = maxDist or 300
    local closestPlayer, closestDist = nil, maxDist
    local aimOrigin = getAimOrigin()
    for _, p in ipairs(getEnemies()) do
        local char = p.Character
        if char then
            local head = char:FindFirstChild("Head")
            if head then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - aimOrigin).Magnitude
                    if dist < closestDist then
                        closestDist   = dist
                        closestPlayer = p
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function getClosestPlayerWorldspace()
    local localChar = LocalPlayer.Character
    if not localChar then return nil end
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end
    local closest, dist = nil, math.huge
    for _, p in ipairs(getEnemies()) do
        local char = p.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local d = (root.Position - localRoot.Position).Magnitude
                if d < dist then
                    dist    = d
                    closest = p
                end
            end
        end
    end
    return closest
end

local function getBodyPart(player, part)
    if not player or not player.Character then return nil end
    return player.Character:FindFirstChild(part)
        or player.Character:FindFirstChild("HumanoidRootPart")
end

local function predictPosition(root, hitbox, pingMs)
    if not root then return root and root.Position end
    local ping = pingMs
        or (workspace:FindFirstChild("ServerPing")
        and workspace.ServerPing.Value or 80)
    local vel = root.AssemblyLinearVelocity
    return root.Position + vel * (ping / 1000)
end

