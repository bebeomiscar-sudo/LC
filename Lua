local espBoxes={}
local function updateESP()
    for _,p in ipairs(plr:GetPlayers()) do
        if p==lp then continue end
        local chr=p.Character; local hm=chr and chr:FindFirstChildOfClass("Humanoid")
        if not chr or not hm or hm.Health<=0 then
            if espBoxes[p] then espBoxes[p]:Destroy(); espBoxes[p]=nil end; continue
        end
        if VIS.esp then
            if not espBoxes[p] then
                local b=Instance.new("SelectionBox")
                b.Color3=Color3.fromRGB(255,50,50); b.LineThickness=0.05
                b.SurfaceTransparency=1; b.Adornee=chr; b.Parent=ws
                espBoxes[p]=b
            end
        else
            if espBoxes[p] then espBoxes[p]:Destroy(); espBoxes[p]=nil end
        end
    end
end

-- UTILITY ESP
local utilESPObjects={}; local utilESPEnabled=false
local utilKeywords={"grenade","flashbang","smoke","molotov","throwable","utility","mine","satchel","snowball"}
local function updateUtilESP()
    if not utilESPEnabled then return end
    for i=#utilESPObjects,1,-1 do
        local obj=utilESPObjects[i]
        if not obj.part or not obj.part.Parent then
            pcall(function() obj.label:Remove() end); pcall(function() obj.dist:Remove() end)
            table.remove(utilESPObjects, i)
        end
    end
    for _,part in pairs(ws:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("Model") then
            local nm=part.Name:lower(); local isUtil=false
            for _,kw in ipairs(utilKeywords) do if nm:find(kw) then isUtil=true; break end end
            if isUtil then
                local already=false
                for _,ex in pairs(utilESPObjects) do if ex.part==part then already=true; break end end
                if not already then
                    local ld=Drawing.new("Text"); ld.Size=14; ld.Color=Color3.fromRGB(255,200,0); ld.Outline=true; ld.Text="["..part.Name.."]"
                    local dd=Drawing.new("Text"); dd.Size=12; dd.Color=Color3.fromRGB(200,200,200); dd.Outline=true
                    table.insert(utilESPObjects, {part=part, label=ld, dist=dd})
                end
            end
        end
    end
    if hrp then
        for _,obj in pairs(utilESPObjects) do
            local pos3d
            if obj.part:IsA("BasePart") then pos3d=obj.part.Position
            elseif obj.part:IsA("Model") and obj.part.PrimaryPart then pos3d=obj.part.PrimaryPart.Position end
            if pos3d then
                local sp,on=cam:WorldToViewportPoint(pos3d)
                obj.label.Visible=on; obj.dist.Visible=on
                if on then
                    obj.label.Position=Vector2.new(sp.X, sp.Y-20)
                    obj.dist.Text=math.floor((pos3d-hrp.Position).Magnitude).."m"
                    obj.dist.Position=Vector2.new(sp.X, sp.Y-6)
                end
            end
        end
    end
end

