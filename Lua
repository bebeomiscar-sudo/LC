-- BULLET TRACER HELPERS
-- ============================================================
local function createLinearTracer(f, t, color, fade)
    local line       = Drawing.new("Line")
    line.From        = f
    line.To          = t
    line.Color       = color
    line.Thickness   = 1.5
    line.Visible     = true
    task.delay(fade, function()
        for i = 1, 10 do
            line.Transparency = i / 10
            task.wait(fade / 10)
        end
        line:Remove()
    end)
end

local function createLightningTracer(f, t, color, fade)
    local segments = 8
    local prev     = f
    local lines    = {}
    for i = 1, segments do
        local base   = f:Lerp(t, i / segments)
        local jitter = Vector2.new(math.random(-15, 15), math.random(-15, 15))
        local seg    = Drawing.new("Line")
        seg.From     = prev
        seg.To       = base + jitter
        seg.Color    = color
        seg.Thickness = 1
        seg.Visible  = true
        table.insert(lines, seg)
        prev = seg.To
    end
    task.delay(fade, function()
        for _, l in pairs(lines) do pcall(function() l:Remove() end) end
    end)
end

local function createDragonTracer(f, t, color, fade)
    local segments = 12
    local prev     = f
    local lines    = {}
    for i = 1, segments do
        local tv   = i / segments
        local base = f:Lerp(t, tv)
        local wave = math.sin(tv * math.pi * 4) * 20
        local seg  = Drawing.new("Line")
        seg.From   = prev
        seg.To     = base + Vector2.new(wave, wave * 0.5)
        seg.Color  = Color3.fromRGB(255, math.floor(50 + tv * 150), 0)
        seg.Thickness = 2
        seg.Visible = true
        table.insert(lines, seg)
        prev = seg.To
    end
    task.delay(fade, function()
        for _, l in pairs(lines) do pcall(function() l:Remove() end) end
    end)
end

local function createSonicTracer(f, t, color, fade)
    local line     = Drawing.new("Line")
    line.From      = f
    line.To        = t
    line.Color     = Color3.fromRGB(30, 200, 255)
    line.Thickness = 2.5
    line.Visible   = true
    local ring     = Drawing.new("Circle")
    ring.Position  = f
    ring.Radius    = 8
    ring.Filled    = false
    ring.Color     = Color3.fromRGB(30, 200, 255)
    ring.Thickness = 1.5
    ring.Visible   = true
    task.delay(fade, function()
        pcall(function() line:Remove() end)
        pcall(function() ring:Remove() end)
    end)
end

local function createMinecraftTracer(f, t, color, fade)
    local segments = 6
    local prev     = f
    local lines    = {}
    for i = 1, segments do
        local base  = f:Lerp(t, i / segments)
        local snap  = Vector2.new(
            math.floor(base.X / 8) * 8,
            math.floor(base.Y / 8) * 8
        )
        local seg   = Drawing.new("Line")
        seg.From    = prev
        seg.To      = snap
        seg.Color   = Color3.fromRGB(100, 255, 100)
        seg.Thickness = 3
        seg.Visible = true
        table.insert(lines, seg)
        prev = seg.To
    end
    task.delay(fade, function()
        for _, l in pairs(lines) do pcall(function() l:Remove() end) end
    end)
end

local function spawnTracer(fromWorld, toWorld)
    if not State.TracerEnabled then return end
    local fromScreen, fs = Camera:WorldToViewportPoint(fromWorld)
    local toScreen,   ts = Camera:WorldToViewportPoint(toWorld)
    if not fs or not ts then return end
    local f2    = Vector2.new(fromScreen.X, fromScreen.Y)
    local t2    = Vector2.new(toScreen.X, toScreen.Y)
    local style = State.TracerStyle
    local color = State.TracerColor
    local fade  = State.TracerFadeTime
    if style == "Line"          then createLinearTracer(f2, t2, color, fade)
    elseif style == "Lightning" then createLightningTracer(f2, t2, color, fade)
    elseif style == "Dragon"    then createDragonTracer(f2, t2, color, fade)
    elseif style == "Sonic"     then createSonicTracer(f2, t2, color, fade)
    elseif style == "Minecraft" then createMinecraftTracer(f2, t2, color, fade)
    end
end

-- ============================================================
-- RAGEBOT HEARTBEAT
-- ============================================================
local ragebotCooldown = 0

RunService.Heartbeat:Connect(function(dt)
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not State.RagebotEnabled or not localRoot then return end

    local now = tick()
    if now - ragebotCooldown < 0.12 then return end
    ragebotCooldown = now

    local enemies = getEnemies()
    if #enemies == 0 then return end

    local target = nil
    local mode   = State.RagebotMode

    if mode == "Closest" then
        target = getClosestPlayerWorldspace()
    elseif mode == "LowestHP" then
        local lowestHP = math.huge
        for _, p in ipairs(enemies) do
            local char = p.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health < lowestHP then
                lowestHP = hum.Health
                target   = p
            end
        end
    elseif mode == "Sequential" then
        target = enemies[(math.floor(now * 10) % #enemies) + 1]
    end

    if not target or not target.Character then return end
    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local predictedPos = predictPosition(targetRoot)

    if State.RagebotDesync and not ragebotDesyncActive then
        ragebotDesyncActive = true
        originalRootPos     = localRoot.CFrame

        if State.RagebotInstantAim and R_UpdateCameraRotations then
            local aimCF = CFrame.new(predictedPos, predictedPos + Vector3.new(0, 0, 1))
            pcall(function() R_UpdateCameraRotations:FireServer(aimCF) end)
        end

        localRoot.CFrame = CFrame.new(predictedPos + Vector3.new(0, 0, -2))

        if R_UseItem then
            pcall(function() R_UseItem:InvokeServer() end)
        end

        if originalRootPos then
            spawnTracer(originalRootPos.Position, predictedPos)
        end

        task.delay(0.06, function()
            if localRoot and originalRootPos then
                localRoot.CFrame = originalRootPos
            end
            ragebotDesyncActive = false
        end)

    elseif not State.RagebotDesync then
        if R_UseItem then
            pcall(function() R_UseItem:InvokeServer() end)
        end
        spawnTracer(localRoot.Position, predictedPos)
    end
end)

