-- ══════════════════════════════════════════════
--            BAITING SYSTEM
-- ══════════════════════════════════════════════
do
    local bait = {
        active        = false,
        mode          = "freeze",
        frozenCF      = nil,
        customPos     = nil,
        orbitCenter   = nil,
        orbitRadius   = 10,
        orbitSpeed    = 1.5,
        orbitAngle    = 0,
        timerEnabled  = false,
        timerDur      = 5,
        timerElapsed  = 0,
        ghostFlash    = false,
        flashDur      = 0.12,
        flashCooldown = 3,
        _flashTimer   = 0,
        _inFlash      = false,
        _flashElapsed = 0,
        _mt           = getrawmetatable(game),
        _oldNewindex  = nil,
        _conn         = nil,
    }

    local function getBaitCF(dt)
        if bait.mode == "freeze" then
            return bait.frozenCF
        elseif bait.mode == "custom" and bait.customPos then
            return CFrame.new(bait.customPos)
        elseif bait.mode == "orbit" and bait.orbitCenter then
            bait.orbitAngle = bait.orbitAngle + bait.orbitSpeed * dt
            local ox = bait.orbitCenter.X + math.cos(bait.orbitAngle) * bait.orbitRadius
            local oz = bait.orbitCenter.Z + math.sin(bait.orbitAngle) * bait.orbitRadius
            return CFrame.new(Vector3.new(ox, bait.orbitCenter.Y, oz))
        end
        return bait.frozenCF
    end

    local function installHook()
        local hrp = getHRP()
        if not hrp then return false end
        bait._oldNewindex = bait._mt.__newindex
        setreadonly(bait._mt, false)
        bait._mt.__newindex = newcclosure(function(self, key, value)
            if bait.active and self == hrp and key == "CFrame" then
                if bait._inFlash then
                    return bait._oldNewindex(self, key, value)
                end
                local fakeCF = getBaitCF(0)
                if fakeCF then
                    return bait._oldNewindex(self, key, fakeCF)
                end
            end
            return bait._oldNewindex(self, key, value)
        end)
        setreadonly(bait._mt, true)
        return true
    end

    local function removeHook()
        if not bait._oldNewindex then return end
        setreadonly(bait._mt, false)
        bait._mt.__newindex = bait._oldNewindex
        setreadonly(bait._mt, true)
        bait._oldNewindex = nil
    end

    bait._conn = RunService.Heartbeat:Connect(function(dt)
        if not bait.active then return end
        if bait.timerEnabled then
            bait.timerElapsed = bait.timerElapsed + dt
            if bait.timerElapsed >= bait.timerDur then
                bait.disable()
                notify("bait", "timer expired — bait disabled")
                return
            end
        end
        if bait.ghostFlash then
            bait._flashTimer = bait._flashTimer + dt
            if bait._inFlash then
                bait._flashElapsed = bait._flashElapsed + dt
                if bait._flashElapsed >= bait.flashDur then
                    bait._inFlash      = false
                    bait._flashTimer   = 0
                    bait._flashElapsed = 0
                end
            elseif bait._flashTimer >= bait.flashCooldown then
                bait._inFlash      = true
                bait._flashElapsed = 0
            end
        end
        if bait.mode == "orbit" and bait.orbitCenter then
            bait.orbitAngle = bait.orbitAngle + bait.orbitSpeed * dt
        end
    end)

    function bait.enable(mode, pos)
        local hrp = getHRP()
        if not hrp then
            notify("bait", "no hrp — spawn first")
            return
        end
        bait.mode         = mode or "freeze"
        bait.frozenCF     = hrp.CFrame
        bait.timerElapsed = 0
        bait._flashTimer  = 0
        bait._inFlash     = false
        if mode == "custom" and pos then
            bait.customPos = typeof(pos) == "Vector3" and pos
                or Vector3.new(pos[1], pos[2], pos[3])
        elseif mode == "orbit" then
            bait.orbitCenter = pos or hrp.Position
            bait.orbitAngle  = 0
        end
        if not bait._oldNewindex then
            if not installHook() then
                notify("bait", "hook failed")
                return
            end
        end
        bait.active = true
        notify("bait", "active — mode: " .. bait.mode)
    end

    function bait.disable()
        bait.active   = false
        bait._inFlash = false
        removeHook()
        notify("bait", "disabled")
    end

    function bait.setFreeze()
        local hrp = getHRP()
        if hrp then
            bait.frozenCF = hrp.CFrame
            notify("bait", "freeze point updated")
        end
    end

    function bait.setTimer(seconds, enabled)
        bait.timerDur     = seconds or 5
        bait.timerEnabled = enabled ~= false
    end

    function bait.setGhostFlash(enabled, flashDur, cooldown)
        bait.ghostFlash    = enabled
        bait.flashDur      = flashDur  or bait.flashDur
        bait.flashCooldown = cooldown  or bait.flashCooldown
    end

    function bait.setOrbit(center, radius, speed)
        bait.orbitCenter = center or bait.orbitCenter
        bait.orbitRadius = radius or bait.orbitRadius
        bait.orbitSpeed  = speed  or bait.orbitSpeed
    end

    getgenv().BaitSystem = bait
end

-- ══════════════════════════════════════════════
--          RIOT SHIELD GODMODE
-- ══════════════════════════════════════════════
do
    local shieldGM = {
        enabled      = false,
        hooked       = false,
        origRef      = nil,
        tblRef       = nil,
        impulseX     = 0,
        impulseY     = -20,
        impulseZ     = 0,
        impulseScale = 1,
    }

    local function buildImpulse()
        return Vector3.new(shieldGM.impulseX, shieldGM.impulseY, shieldGM.impulseZ)
    end

    local function scanAndHook()
        local gc = getgc(false)
        if type(gc) ~= "table" then
            warn("[shieldgm] getgc unavailable")
            return
        end
        for _, v in next, gc do
            if type(v) ~= "table" then continue end
            local ok, rf = pcall(rawget, v, "ReplicateFromServer")
            if not ok or type(rf) ~= "function" then continue end
            local ok2, consts = pcall(debug.getconstants, rf)
            if not ok2 or type(consts) ~= "table" then continue end
            local hasAbsorb = false
            for _, c in next, consts do
                if c == "AbsorbedHit" then hasAbsorb = true break end
            end
            if hasAbsorb then
                local _orig = rf
                v.ReplicateFromServer = newcclosure(function(self, eventName, ...)
                    if eventName == "AbsorbedHit" and shieldGM.enabled then
                        pcall(function()
                            if self and type(self.IsRendered) == "function" and self:IsRendered() then
                                local vm = rawget(self, "ViewModel")
                                if vm and type(vm.Impulse) == "function" then
                                    vm:Impulse(buildImpulse(), shieldGM.impulseScale, nil, true)
                                end
                            end
                        end)
                        return
                    end
                    return _orig(self, eventName, ...)
                end)
                shieldGM.hooked  = true
                shieldGM.origRef = _orig
                shieldGM.tblRef  = v
                notify("shield gm", "godmode active")
                return
            end
        end
        warn("[shieldgm] hook failed — equip riot shield then rehook")
    end

    function shieldGM.enable()
        shieldGM.enabled = true
        if not shieldGM.hooked then task.defer(scanAndHook) end
        notify("shield gm", "enabled")
    end

    function shieldGM.disable()
        shieldGM.enabled = false
        notify("shield gm", "disabled")
    end

    function shieldGM.rehook()
        shieldGM.hooked  = false
        shieldGM.origRef = nil
        shieldGM.tblRef  = nil
        task.defer(scanAndHook)
        notify("shield gm", "rehooking...")
    end

    function shieldGM.setImpulse(x, y, z, scale)
        shieldGM.impulseX     = x     or shieldGM.impulseX
        shieldGM.impulseY     = y     or shieldGM.impulseY
        shieldGM.impulseZ     = z     or shieldGM.impulseZ
        shieldGM.impulseScale = scale or shieldGM.impulseScale
    end

    getgenv().ShieldGM = shieldGM
end

-- ══════════════════════════════════════════════
--            VOID SPAM SYSTEM
-- xyz configurable — rapid void desync
-- ══════════════════════════════════════════════
local VoidSpam = {
    active   = false,
    offsetX  = 0,
    offsetY  = -500,
    offsetZ  = 0,
    speed    = 0.05,
    _timer   = 0,
    _origCF  = nil,
}

RunService.Heartbeat:Connect(function(dt)
    if not VoidSpam.active then return end
    local hrp = getHRP()
    if not hrp then return end

    VoidSpam._timer = VoidSpam._timer + dt
    if VoidSpam._timer >= VoidSpam.speed then
        VoidSpam._timer = 0
        VoidSpam._origCF = hrp.CFrame

        -- build the void target using configured xyz offsets
        local voidCF = CFrame.new(
            hrp.Position.X + VoidSpam.offsetX,
            hrp.Position.Y + VoidSpam.offsetY,
            hrp.Position.Z + VoidSpam.offsetZ
        )

        hrp.CFrame = voidCF

        -- snap back locally next frame
        task.defer(function()
            if hrp and hrp.Parent and VoidSpam._origCF then
                hrp.CFrame = VoidSpam._origCF
            end
        end)
    end
end)

function VoidSpam.start()
    VoidSpam.active = true
    notify("void spam", "started")
end

function VoidSpam.stop()
    VoidSpam.active = false
    notify("void spam", "stopped")
end

-- ══════════════════════════════════════════════
--               DESYNC SYSTEM
-- ══════════════════════════════════════════════
local Desync = {
    active    = false,
    intensity = 8,
    speed     = 0.03,
    _timer    = 0,
    _phase    = 0,
    _mt       = getrawmetatable(game),
    _oldNI    = nil,
    _hooked   = false,
}

local function installDesyncHook()
    if Desync._hooked then return end
    local hrp = getHRP()
    if not hrp then return end
    Desync._oldNI = Desync._mt.__newindex
    setreadonly(Desync._mt, false)
    Desync._mt.__newindex = newcclosure(function(self, key, value)
        if Desync.active and self == hrp and key == "CFrame" then
            local ox = math.sin(Desync._phase * 3.7) * Desync.intensity
            local oz = math.cos(Desync._phase * 2.3) * Desync.intensity
            local fakeCF = CFrame.new(
                value.X + ox,
                value.Y,
                value.Z + oz
            ) * (value - value.Position)
            return Desync._oldNI(self, key, fakeCF)
        end
        return Desync._oldNI(self, key, value)
    end)
    setreadonly(Desync._mt, true)
    Desync._hooked = true
end

local function removeDesyncHook()
    if not Desync._hooked or not Desync._oldNI then return end
    setreadonly(Desync._mt, false)
    Desync._mt.__newindex = Desync._oldNI
    setreadonly(Desync._mt, true)
    Desync._hooked = false
    Desync._oldNI  = nil
end

RunService.Heartbeat:Connect(function(dt)
    if not Desync.active then return end
    Desync._timer = Desync._timer + dt
    if Desync._timer >= Desync.speed then
        Desync._timer = 0
        Desync._phase = Desync._phase + 1
    end
end)

function Desync.enable()
    installDesyncHook()
    Desync.active = true
    notify("desync", "active")
end

function Desync.disable()
    Desync.active = false
    removeDesyncHook()
    notify("desync", "disabled")
end

-- ══════════════════════════════════════════════
--            STANDOFF DESYNC SYSTEM
-- ══════════════════════════════════════════════
local StandoffDesync = {
    active      = false,
    ghostCount  = 3,
    spread      = 6,
    switchRate  = 0.04,
    _ghosts     = {},
    _idx        = 1,
    _timer      = 0,
    _realCF     = nil,
    _mt         = getrawmetatable(game),
    _oldNI      = nil,
    _hooked     = false,
}

local function buildGhosts(hrp)
    StandoffDesync._ghosts = {}
    for i = 1, StandoffDesync.ghostCount do
        local angle = (2 * math.pi / StandoffDesync.ghostCount) * i
        local ox    = math.cos(angle) * StandoffDesync.spread
        local oz    = math.sin(angle) * StandoffDesync.spread
        table.insert(StandoffDesync._ghosts, Vector3.new(ox, 0, oz))
    end
end

local function installStandoffHook()
    if StandoffDesync._hooked then return end
    local hrp = getHRP()
    if not hrp then return end
    buildGhosts(hrp)
    StandoffDesync._oldNI = StandoffDesync._mt.__newindex
    setreadonly(StandoffDesync._mt, false)
    StandoffDesync._mt.__newindex = newcclosure(function(self, key, value)
        if StandoffDesync.active and self == hrp and key == "CFrame" then
            StandoffDesync._realCF = value
            local ghost = StandoffDesync._ghosts[StandoffDesync._idx]
            if ghost then
                local fakeCF = CFrame.new(
                    value.X + ghost.X,
                    value.Y + ghost.Y,
                    value.Z + ghost.Z
                ) * (value - value.Position)
                return StandoffDesync._oldNI(self, key, fakeCF)
            end
        end
        return StandoffDesync._oldNI(self, key, value)
    end)
    setreadonly(StandoffDesync._mt, true)
    StandoffDesync._hooked = true
end

local function removeStandoffHook()
    if not StandoffDesync._hooked or not StandoffDesync._oldNI then return end
    setreadonly(StandoffDesync._mt, false)
    StandoffDesync._mt.__newindex = StandoffDesync._oldNI
    setreadonly(StandoffDesync._mt, true)
    StandoffDesync._hooked = false
    StandoffDesync._oldNI  = nil
end

RunService.Heartbeat:Connect(function(dt)
    if not StandoffDesync.active then return end
    StandoffDesync._timer = StandoffDesync._timer + dt
    if StandoffDesync._timer >= StandoffDesync.switchRate then
        StandoffDesync._timer = 0
        StandoffDesync._idx   = (StandoffDesync._idx % StandoffDesync.ghostCount) + 1
    end
end)

function StandoffDesync.enable()
    installStandoffHook()
    StandoffDesync.active = true
    notify("standoff desync", "active")
end

function StandoffDesync.disable()
    StandoffDesync.active = false
    removeStandoffHook()
    notify("standoff desync", "disabled")
end

-- ══════════════════════════════════════════════
--          UNDERGROUND ANTI AIM
-- hooks fighter controller + camera controller
-- puts the player underground while weapon active
-- camera controller restores pos each update
-- ══════════════════════════════════════════════
local UndergroundAA = {
    active   = false,
    _oldpos  = nil,
    _camHook = nil,
    _conn    = nil,
}

local _fighter_controller = nil
local _local_fighter      = nil
local _camera_controller  = nil
local _old_cam_update     = nil
local _ug_cam_hooked      = false

local function instanceSafeRequire(obj)
    local ok, result = pcall(require, obj)
    if ok then return result end
    return nil
end

local function setupUndergroundControllers()
    if _fighter_controller then return true end

    local ps = lp:FindFirstChild("PlayerScripts")
    if not ps then return false end

    local controllers = ps:FindFirstChild("Controllers")
    if not controllers then return false end

    local fc = controllers:FindFirstChild("FighterController")
    local cc = controllers:FindFirstChild("CameraController")
    if not fc or not cc then return false end

    _fighter_controller = instanceSafeRequire(fc)
    _camera_controller  = instanceSafeRequire(cc)

    if not _fighter_controller or not _camera_controller then return false end

    _local_fighter = _fighter_controller.LocalFighter
    return true
end

local function getFloorBelow(pos)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    if _local_fighter
        and _local_fighter.Entity
        and _local_fighter.Entity.RootPart
    then
        params.FilterDescendantsInstances = {
            _local_fighter.Entity.RootPart.Parent
        }
    end

    local result = workspace:Raycast(pos, Vector3.new(0, -500, 0), params)
    if result then
        return CFrame.new(
            Vector3.new(pos.X, result.Position.Y - 2, pos.Z)
        )
    end
    return nil
end

local function installCamHook()
    if _ug_cam_hooked or not _camera_controller then return end
    _old_cam_update = _camera_controller.Update
    _camera_controller.Update = function(...)
        local args = {...}
        if UndergroundAA.active
            and _local_fighter
            and _local_fighter.Entity
            and _local_fighter.Entity.RootPart
            and UndergroundAA._oldpos
        then
            _local_fighter.Entity.RootPart.CFrame = UndergroundAA._oldpos
        end
        return _old_cam_update(table.unpack(args))
    end
    _ug_cam_hooked = true
end

local function removeCamHook()
    if not _ug_cam_hooked or not _camera_controller then return end
    _camera_controller.Update = _old_cam_update
    _old_cam_update  = nil
    _ug_cam_hooked   = false
end

-- heartbeat driver
RunService.Heartbeat:Connect(function()
    if getgenv().InstanceConfigLoading then return end
    if not UndergroundAA.active then
        UndergroundAA._oldpos = nil
        return
    end

    -- lazy controller setup
    if not _fighter_controller then
        if not setupUndergroundControllers() then return end
        installCamHook()
    end

    if not _local_fighter
        or not _local_fighter.Entity
        or not _local_fighter.Entity.RootPart
    then
        UndergroundAA._oldpos = nil
        return
    end

    local root = _local_fighter.Entity.RootPart

    -- save real position for camera restore
    UndergroundAA._oldpos = root.CFrame

    -- push underground
    local floorCF = getFloorBelow(root.Position)
    if floorCF then
        root.CFrame = floorCF
    end
end)

function UndergroundAA.enable()
    if not setupUndergroundControllers() then
        notify("underground", "controllers not found — try in-game")
        return
    end
    installCamHook()
    UndergroundAA.active = true
    notify("underground", "active")
end

function UndergroundAA.disable()
    UndergroundAA.active  = false
    UndergroundAA._oldpos = nil
    removeCamHook()
    notify("underground", "disabled")
end

-- ══════════════════════════════════════════════
--               DODGE SYSTEM
-- ══════════════════════════════════════════════
local Dodge = {
    active     = false,
    power      = 60,
    cooldown   = 0.8,
    iframes    = 0.25,
    _lastDodge = 0,
    _inFrame   = false,
}

local function getDodgeDir()
    local hrp = getHRP()
    if not hrp then return Vector3.new(0, 0, -1) end
    local camLook  = camera.CFrame.LookVector
    local camRight = camera.CFrame.RightVector
    local dir      = Vector3.new(0, 0, 0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
        dir = dir + Vector3.new(camLook.X, 0, camLook.Z)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
        dir = dir - Vector3.new(camLook.X, 0, camLook.Z)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
        dir = dir - Vector3.new(camRight.X, 0, camRight.Z)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
        dir = dir + Vector3.new(camRight.X, 0, camRight.Z)
    end
    if dir.Magnitude < 0.1 then
        dir = Vector3.new(camLook.X, 0, camLook.Z)
    end
    return dir.Unit
end

local function executeDodge()
    if not Dodge.active then return end
    if (tick() - Dodge._lastDodge) < Dodge.cooldown then return end
    local hrp = getHRP()
    if not hrp then return end
    Dodge._lastDodge = tick()
    Dodge._inFrame   = true
    local dir    = getDodgeDir()
    local target = hrp.CFrame + (dir * Dodge.power)
    local tween  = TweenService:Create(
        hrp,
        TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = target }
    )
    tween:Play()
    task.delay(Dodge.iframes, function()
        Dodge._inFrame = false
    end)
    notify("dodge", "dash!")
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if not Dodge.active then return end
    if input.KeyCode == Enum.KeyCode.Q then
        executeDodge()
    end
end)

